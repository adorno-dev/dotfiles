#!/bin/bash

SDK="$HOME/.android-sdk"
TOOLS_VERSION="15859902"
ANDROID_VERSION="36"
BUILD_TOOLS_VERSION="36.0.0"
NDK_VERSION="25.2.9519653"
IMAGE="google_apis;x86_64"

TOOLS="commandlinetools-linux-${TOOLS_VERSION}_latest.zip"
URL="https://dl.google.com/android/repository/$TOOLS"

command -v java >/dev/null || { echo "Error: Java is required."; exit 1; }

mkdir -p "$SDK/cmdline-tools"
cd "$SDK"

if [ ! -x "$SDK/cmdline-tools/latest/bin/sdkmanager" ]; then
    echo "Downloading Android command-line tools..."
    curl -fsSLO "$URL"
    unzip -q "$TOOLS" -d cmdline-tools
    mv cmdline-tools/cmdline-tools cmdline-tools/latest
    rm "$TOOLS"
fi

SDKMANAGER="$SDK/cmdline-tools/latest/bin/sdkmanager"

echo "Accepting Android SDK licenses..."
yes | "$SDKMANAGER" --sdk_root="$SDK" --licenses >/dev/null

echo "Installing Android SDK components..."
"$SDKMANAGER" --sdk_root="$SDK" \
    "platform-tools" \
    "platforms;android-$ANDROID_VERSION" \
    "build-tools;$BUILD_TOOLS_VERSION" \
    "ndk;$NDK_VERSION" \
    "emulator" \
    "system-images;android-$ANDROID_VERSION;$IMAGE"

echo "Android SDK installation completed."
echo ""
echo "Add the following to ~/.bashrc or ~/.zshrc:"
echo 'export JAVA_HOME="/usr/lib/jvm/java-21-openjdk"'
echo 'export ANDROID_SDK_ROOT="$HOME/.android-sdk"'
echo 'export ANDROID_HOME="$HOME/.android-sdk"'
echo 'export ANDROID_NDK_ROOT="$ANDROID_HOME/ndk/'"$NDK_VERSION"'"'
echo 'export PATH="$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin:$PATH"'
echo 'export PATH="$ANDROID_HOME/platform-tools:$PATH"'
echo 'export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"'
echo 'export PATH="$ANDROID_HOME/emulator:$PATH"'

#!/bin/bash

# sudo pacman -S --needed base-devel git cmake ninja curl gettext

export CFLAGS="-O3 -march=native -mtune=native -flto=auto -fomit-frame-pointer"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-flto=auto"

if [ -d "neovim/.git" ]; then
    cd neovim
    git pull --ff-only
else
    git clone https://github.com/neovim/neovim.git
    cd neovim
fi

make CMAKE_BUILD_TYPE=Release \
     CMAKE_EXTRA_FLAGS="-DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++" \
     -j"$(nproc)"

sudo make install

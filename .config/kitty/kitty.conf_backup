# Fonte bonita para ícones
#font_family      GeistMono Nerd Font
#font_size        10.3
#
## Truecolor para Catppuccin
#enable_audio_bell no
#allow_remote_control yes
#
## Scrollback grande
#scrollback_lines 10000
#
#allow_cursor_shape_change yes
#
## Mouse: desativa o tmux interceptar, permite copiar livre
#mouse_reporting no
#
## Atalhos para nova aba/janela
#map ctrl+shift+t new_tab
#map ctrl+shift+w close_tab



# include current-theme.conf

cursor_shape beam
cursor_beam_thickness 0.5
cursor_blink_interval -1
cursor_trail 3
shell_integration no-cursor

allow_remote_control yes
allow_hyperlinks yes
map ctrl+shift+p>y kitten hints --type hyperlink
underline_hyperlinks hover
enable_graphics yes

# font_family GeistMono Nerd Font
# font_family JetBrainsMono Nerd Font
font_family JetBrainsMono NF ExtraLight
font_weight light

normal_font         auto
bold_font           auto
italic_font         auto
bold_italic_font    auto

font_size 10

background_opaticy 0.8
background_tint 0.1
background_blur 7
dynamic_background_opacity yes


# BEGIN_KITTY_THEME
# Catppuccin-Mocha
include current-theme.conf
# END_KITTY_THEME
